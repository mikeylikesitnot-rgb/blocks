{
  "name": "@mn/blocks",
  "version": "0.20.0",
  "description": "Blocks: Michael's shared building blocks. React UI (tokens, components, login page, attachments, optional rich text editor), Express server pieces (auth, email, rate limits), ops scripts (nightly VPS backup) and a one-line-per-export CATALOG.md.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": "github:mikeylikesitnot-rgb/blocks",
  "private": true,
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./tokens.css": "./src/tokens.css",
    "./kit.css": "./src/kit.css",
    "./editor": "./src/editor/index.js",
    "./editor/lite": "./src/editor/lite.js",
    "./editor.css": "./src/editor/editor.css",
    "./package.json": "./package.json",
    "./server": "./server/index.js",
    "./email": "./server/email.js"
  },
  "files": [
    "src",
    "server",
    "ops",
    "README.md",
    "CATALOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite demo",
    "build:demo": "vite build demo",
    "test": "vitest run",
    "example": "node examples/server.js",
    "catalog": "node scripts/catalog.mjs",
    "catalog:check": "node scripts/catalog.mjs --check",
    "verify": "npm run catalog:check && npm test && npm run build:demo"
  },
  "peerDependencies": {
    "@tiptap/pm": "^3.20.1",
    "@tiptap/react": "^3.20.1",
    "@tiptap/starter-kit": "^3.20.1",
    "bcryptjs": "^3.0.3",
    "express": ">=4.21",
    "express-rate-limit": "^8.6.0",
    "jose": "^6.2.17",
    "nodemailer": "^7.0.13 || ^8.0.0 || ^9.0.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@tiptap/pm": "^3.20.1",
    "@tiptap/react": "^3.20.1",
    "@tiptap/starter-kit": "^3.20.1",
    "@vitejs/plugin-react": "^4.5.2",
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "jose": "^6.2.17",
    "jsdom": "^26.1.0",
    "nodemailer": "^7.0.13",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "supertest": "^7.3.2",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "peerDependenciesMeta": {
